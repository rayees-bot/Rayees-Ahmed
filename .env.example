# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional live Razorpay merchant credentials.
# When omitted, MediQuick uses server-verified HMAC-SHA256 Razorpay sandbox checkout.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
